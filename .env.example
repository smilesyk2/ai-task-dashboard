# ================================================================
# AI Task Dashboard — 환경 변수 설정
# 이 파일을 복사해서 .env 파일을 만드세요:
#   cp .env.example .env
# ================================================================

# PostgreSQL 연결 문자열 (필수)
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_task_dashboard

# API 서버 포트 (선택, 기본: 3001)
PORT=3001

# 프론트엔드 허용 Origin (선택, 기본: http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Anthropic API 키 (선택 — 관리자 페이지 LLM 설정에서도 입력 가능)
# Claude LLM 자동분류를 위해 필요합니다.
VITE_ANTHROPIC_API_KEY=sk-ant-여기에_API_키_입력
